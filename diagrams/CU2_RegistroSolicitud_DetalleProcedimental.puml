@startuml
allowmixing
hide empty members
title CU2 - Gestion del Registro y Envio de Solicitud de Caso Especial (Detalle Procedimental)

skinparam backgroundColor #101318
skinparam packageStyle rectangle
skinparam shadowing false
skinparam ArrowColor #BFC7D5
skinparam classBorderColor #D6D9E0
skinparam classFontColor #0F172A
skinparam classBackgroundColor #FFF8E7
skinparam noteBackgroundColor #FFFCEB
skinparam noteBorderColor #C5A880
skinparam classAttributeIconSize 0

class "proyectomailgrupo02sa::Principal" as Principal <<JFrame>> {
  - iniciar: Home
  - enviar: SendEmail
  - tf_mailfrom: JTextField
  - tf_rcptto: JTextField
  - tf_subject: JTextField
  - ta_respuesta: JEditorPane
  + Principal()
}

interface ITokenCasoUsoEventListener {
  + solicitud(TokenEvent): void
  + solicitudGrupo(TokenEvent): void
  + archivoSolicitud(TokenEvent): void
}

class "Comunication::Home" as Home {
  + interprete(email: Email): void
  + mostraRespuesta(textoHtml): void
}

class "Models::Solicitud" as Solicitud {
  - id: int
  - codigo: String
  - idEstudiante: int
  - idPeriodo: int
  - tipoCaso: String
  - motivo: String
  - estado: String
  - fechaSolicitud: Timestamp
  - fechaRevision: Timestamp
  - idRevisor: Integer
  - observaciones: String
}

class "Models::SolicitudGrupo" as SolicitudGrupo {
  - id: int
  - idSolicitud: int
  - idGrupo: int
  - motivo: String
  - estado: String
}

class "Models::ArchivoSolicitud" as ArchivoSolicitud {
  - id: int
  - idSolicitud: int
  - nombreArchivo: String
  - tipoArchivo: String
  - rutaArchivo: String
  - fechaSubida: Timestamp
}

class "Services::SolicitudService" as SolicitudService {
  - solicitudDAO: SolicitudDAO
  - solicitudGrupoDAO: SolicitudGrupoDAO
  - historialDAO: HistorialSolicitudDAO
  - notificacionDAO: NotificacionDAO
  + registrarSolicitud(params: List<String>, remitenteEmail: String): Solicitud
  + agregarGrupoASolicitud(params: List<String>): void
  + listarSolicitudes(): List<String[]>
  + consultarSolicitud(id: int): String[]
  + listarGruposDeSolicitud(idSolicitud: int): List<String[]>
  + getComandosSolicitud(): String
}

class "Services::ArchivoSolicitudService" as ArchivoSolicitudService {
  - dao: ArchivoSolicitudDAO
  + adjuntarArchivo(params: List<String>): void
  + listarArchivosDeSolicitud(idSolicitud: int): List<String[]>
}

class "DAO::SolicitudDAO" as SolicitudDAO {
  - con: Connection
  + create(sol: Solicitud): void
  + listAll(): List<String[]>
  + readById(id: int): String[]
  + updateEstado(id: int, estado: String, ...): void
  + getEstado(id: int): String
}

class "DAO::SolicitudGrupoDAO" as SolicitudGrupoDAO {
  - con: Connection
  + create(sg: SolicitudGrupo): void
  + listBySolicitud(idSolicitud: int): List<String[]>
}

class "DAO::ArchivoSolicitudDAO" as ArchivoSolicitudDAO {
  - con: Connection
  + create(archivo: ArchivoSolicitud): void
  + listBySolicitud(idSolicitud: int): List<String[]>
}

class "DAO::HistorialSolicitudDAO" as HistorialSolicitudDAO {
  + create(hist: HistorialSolicitud): void
}

class "DAO::NotificacionDAO" as NotificacionDAO {
  + create(notif: Notificacion): void
}

class "Database::Conexion" as Conexion {
  + EstablecerConexion(): Connection
  + getInstancia(): Conexion
}

note right of SolicitudService
  Genera numero unico de seguimiento
  (ej. SOL-2026-0045) y registra
  evento en historial de tramite
  con acuse de recibo automatico.
end note

Principal --> Home : -iniciar
Home ..> ITokenCasoUsoEventListener : listener solicitud(TokenEvent)
Home --> SolicitudService : solicitud(event)
Home --> ArchivoSolicitudService : archivoSolicitud(event)
SolicitudService --> SolicitudDAO : solicitudDAO
SolicitudService --> SolicitudGrupoDAO : solicitudGrupoDAO
SolicitudService --> HistorialSolicitudDAO : historialDAO
SolicitudService --> NotificacionDAO : notificacionDAO
ArchivoSolicitudService --> ArchivoSolicitudDAO : dao
SolicitudDAO --> Solicitud : mapea
SolicitudGrupoDAO --> SolicitudGrupo : mapea
ArchivoSolicitudDAO --> ArchivoSolicitud : mapea
SolicitudDAO --> Conexion : getInstancia().EstablecerConexion()
SolicitudGrupoDAO --> Conexion : getInstancia().EstablecerConexion()
ArchivoSolicitudDAO --> Conexion : getInstancia().EstablecerConexion()

@enduml
